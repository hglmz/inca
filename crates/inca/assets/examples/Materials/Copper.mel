// @name Copper
// @description Polished copper: a fully metallic standardSurface with a reddish-orange reflectance.
// @kind material
string $sel[] = `ls -sl`;
string $m = `shadingNode -asShader standardSurface -n copper`;
setAttr ($m + ".base") 1;
setAttr ($m + ".baseColor") -type double3 0.955 0.56 0.42;
setAttr ($m + ".metalness") 1;
setAttr ($m + ".specular") 1;
setAttr ($m + ".specularRoughness") 0.2;
if (size($sel) > 0) {
    select -r $sel;
    hyperShade -assign $m;
}
