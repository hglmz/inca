// @name Red Plastic
// @description Glossy red plastic: a dielectric standardSurface with a saturated base colour and a sharp highlight.
// @kind material
string $sel[] = `ls -sl`;
string $m = `shadingNode -asShader standardSurface -n redPlastic`;
setAttr ($m + ".base") 1;
setAttr ($m + ".baseColor") -type double3 0.7 0.04 0.03;
setAttr ($m + ".metalness") 0;
setAttr ($m + ".specular") 1;
setAttr ($m + ".specularRoughness") 0.15;
setAttr ($m + ".specularIOR") 1.5;
if (size($sel) > 0) {
    select -r $sel;
    hyperShade -assign $m;
}
