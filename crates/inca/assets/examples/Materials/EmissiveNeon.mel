// @name Emissive Neon
// @description Cyan neon: a standardSurface whose emission makes it glow and light its surroundings.
// @kind material
string $sel[] = `ls -sl`;
string $m = `shadingNode -asShader standardSurface -n neon`;
setAttr ($m + ".base") 0.8;
setAttr ($m + ".baseColor") -type double3 0.05 0.3 0.4;
setAttr ($m + ".metalness") 0;
setAttr ($m + ".specular") 1;
setAttr ($m + ".specularRoughness") 0.3;
setAttr ($m + ".emission") 4;
setAttr ($m + ".emissionColor") -type double3 0.1 0.85 1;
if (size($sel) > 0) {
    select -r $sel;
    hyperShade -assign $m;
}
