// @name Primitive Showcase
// @description Every polygon primitive in Inca, from cube to dodecahedron, lined up on a studio floor in soft pastel colors.
// @kind scene

// ---- pastel materials (names are captured, so a second import gets its own set)
string $mFloor = `shadingNode -asShader lambert -n psFloorMtl`;
setAttr ($mFloor + ".color") -type double3 0.52 0.51 0.50;
string $mLabel = `shadingNode -asShader lambert -n psLabelMtl`;
setAttr ($mLabel + ".color") -type double3 0.12 0.13 0.17;

float $pal[] = {
    0.94, 0.52, 0.55,
    0.98, 0.72, 0.45,
    0.96, 0.87, 0.45,
    0.58, 0.86, 0.55,
    0.45, 0.82, 0.80,
    0.50, 0.68, 0.95,
    0.68, 0.56, 0.93,
    0.94, 0.56, 0.80,
    0.74, 0.88, 0.45,
    0.45, 0.74, 0.88,
    0.97, 0.62, 0.55,
    0.76, 0.64, 0.90 };
string $mats[];
for ($i = 0; $i < 12; $i++) {
    string $m = `shadingNode -asShader standardSurface -n ("psPastelMtl" + ($i + 1))`;
    setAttr ($m + ".baseColor") -type double3 $pal[$i * 3] $pal[$i * 3 + 1] $pal[$i * 3 + 2];
    setAttr ($m + ".specularRoughness") 0.45;
    setAttr ($m + ".specular") 0.4;
    $mats[$i] = $m;
}

// ---- floor
string $floor[] = `polyPlane -w 50 -h 50 -sx 1 -sy 1 -n psGround`;
select -r $floor[0];
hyperShade -assign $mFloor;

// ---- the twelve primitives: back row then front row, 3 units apart
string $types[] = { "polyCube", "polySphere", "polyCylinder", "polyCone", "polyPlane", "polyTorus",
                    "polyPyramid", "polyPrism", "polyPipe", "polyHelix", "polyDisc", "polyPlatonic" };
string $objs[];
string $r[];
$r = `polyCube -w 1.5 -h 1.5 -d 1.5 -n psCube`;
xform -ws -t 0 0.75 0 -ro 0 25 0 $r[0];
$objs[0] = $r[0];
$r = `polySphere -r 0.9 -sa 32 -sh 24 -n psSphere`;
xform -ws -t 0 0.9 0 $r[0];
$objs[1] = $r[0];
$r = `polyCylinder -r 0.7 -h 1.7 -sa 32 -n psCylinder`;
xform -ws -t 0 0.85 0 $r[0];
$objs[2] = $r[0];
$r = `polyCone -r 0.85 -h 1.9 -sa 32 -n psCone`;
xform -ws -t 0 0.95 0 $r[0];
$objs[3] = $r[0];
$r = `polyPlane -w 1.6 -h 1.6 -sx 4 -sy 4 -n psPlane`;
xform -ws -t 0 0.9 0 -ro 70 0 0 $r[0];
$objs[4] = $r[0];
$r = `polyTorus -r 0.7 -sr 0.25 -sa 32 -sh 16 -n psTorus`;
xform -ws -t 0 0.95 0 -ro 90 0 0 $r[0];
$objs[5] = $r[0];
$r = `polyPyramid -w 1.7 -ns 4 -n psPyramid`;
xform -ws -t 0 0.6 0 -ro 0 20 0 $r[0];
$objs[6] = $r[0];
$r = `polyPrism -l 1.5 -w 0.85 -ns 6 -n psPrism`;
xform -ws -t 0 0.75 0 $r[0];
$objs[7] = $r[0];
$r = `polyPipe -r 0.8 -h 1.2 -t 0.25 -sa 32 -n psPipe`;
xform -ws -t 0 0.6 0 $r[0];
$objs[8] = $r[0];
$r = `polyHelix -c 3 -h 1.6 -w 1.3 -r 0.14 -sa 10 -sco 60 -n psHelix`;
xform -ws -t 0 0.95 0 $r[0];
$objs[9] = $r[0];
$r = `polyDisc -r 0.85 -s 24 -n psDisc`;
xform -ws -t 0 0.9 0 -ro 70 0 0 $r[0];
$objs[10] = $r[0];
$r = `polyPlatonic -p 3 -r 0.9 -n psDodecahedron`;
xform -ws -t 0 0.9 0 $r[0];
$objs[11] = $r[0];

// lay them out on a 6 x 2 grid (rows far enough apart that the back labels stay visible), each with a flat polyType label in front
string $labels[];
for ($i = 0; $i < 12; $i++) {
    float $x = -7.5 + 3.0 * ($i % 6);
    float $z = ($i < 6) ? -3.4 : 1.4;
    move -r $x 0 $z $objs[$i];
    // rest the lowest point on the floor (the tilted plane and disc, the dodecahedron and the helix would float)
    float $ob[] = `xform -q -ws -bb $objs[$i]`;
    move -r 0 (-$ob[1]) 0 $objs[$i];
    select -r $objs[$i];
    hyperShade -assign $mats[$i];
    string $t[] = `polyType -t $types[$i] -fs 0.36 -d 0.02 -n ("psLabel_" + $types[$i])`;
    float $bb[] = `xform -q -ws -bb $t[0]`;
    xform -ws -t ($x - ($bb[0] + $bb[3]) / 2.0) 0.011 ($z + 1.35) -ro -90 0 0 $t[0];
    select -r $t[0];
    hyperShade -assign $mLabel;
    $labels[$i] = $t[0];
}

// ---- lights: warm sun with soft sky fill (consistent in viewport and path tracer)
string $sun = `directionalLight -n psSun`;
setAttr ($sun + ".intensity") 1.25;
setAttr ($sun + ".color") -type double3 1.0 0.95 0.86;
setAttr ($sun + ".shadows") 1;
xform -ws -t -6 10 8 -ro -55 -35 0 $sun;
string $sky = `skyDomeLight -n psSky`;
setAttr ($sky + ".color") -type double3 0.78 0.84 0.96;
setAttr ($sky + ".intensity") 0.26;
// the dome icon sits under the floor, out of sight (its position does not matter)
xform -ws -t 0 -5 0 $sky;

select -r $floor[0] $objs $labels $sun $sky;
group -n PrimitiveShowcase;
select -cl;
// @settings
xform -ws -t 0 13 15.5 -ro -38 0 0 persp;
setAttr perspShape.focalLength 34;
setAttr perspShape.coi 21.1;
setAttr defaultRenderGlobals.renderer -type "string" "path";
setAttr defaultRenderGlobals.camera -type "string" "persp";
setAttr defaultResolution.width 640;
setAttr defaultResolution.height 360;
setAttr defaultRenderGlobals.samples 128;
setAttr defaultRenderGlobals.bounces 4;
setAttr defaultRenderGlobals.toneMapping -type "string" "neutral";
